{
  "version": 1,
  "tweaks": [
    {
      "id": "os-updates",
      "name": "Meta OS updates",
      "area": "Updates",
      "summary": "Keeps the headset on its rooted firmware: the OTA switch is off and the updater app is disabled. An OS update could replace the rooted boot image.",
      "author": "PrivateQuest setup + Bubbagum88",
      "url": "https://github.com/Bubbagum88/QuestEnhancer/tree/main/fixes/08-ocms-auto-updates",
      "licence": "GPL-3.0",
      "risk": "safe",
      "check": "echo \"ota=$(getprop persist.ovr.ota.enabled)\"; if pm list packages -d | grep -qx package:com.oculus.updater; then echo updater=disabled; else echo updater=enabled; fi",
      "controls": [
        {
          "type": "switch",
          "label": "Block OS updates",
          "state": "^ota=false\\nupdater=disabled$",
          "on": "setprop persist.ovr.ota.enabled false; pm disable-user --user 0 com.oculus.updater",
          "off": "resetprop -p --delete persist.ovr.ota.enabled; pm enable com.oculus.updater",
          "hint": "OTA switch off and com.oculus.updater disabled",
          "confirmOff": "This lets Meta install OS updates again. An update can replace the rooted boot image and undo these fixes. Allow OS updates?"
        }
      ]
    },
    {
      "id": "ocms-auto-updates",
      "name": "Meta app auto-updates blocked",
      "area": "Updates",
      "summary": "Fix 08: the OCMS hook stops Meta's apps updating themselves. OCMS itself must stay enabled.",
      "author": "Bubbagum88",
      "url": "https://github.com/Bubbagum88/QuestEnhancer/tree/main/fixes/08-ocms-auto-updates",
      "licence": "GPL-3.0",
      "risk": "safe",
      "check": "if sh /data/adb/modules/zygisk_vector/cli scope ls org.codeberg.anonymous950.questenhancer | grep -q com.oculus.ocms; then echo \"in scope\"; else echo \"not in scope\"; fi; if pm list packages -d | grep -qx package:com.oculus.ocms; then echo \"OCMS DISABLED\"; else echo \"OCMS enabled\"; fi",
      "after": "reboot",
      "controls": [
        {
          "type": "switch",
          "label": "Block Meta app auto-updates",
          "state": "^in scope$",
          "on": "sh /data/adb/modules/zygisk_vector/cli scope set org.codeberg.anonymous950.questenhancer com.oculus.systemux/0 com.oculus.vrshell/0 com.oculus.panelapp.settings/0 com.oculus.horizon/0 com.oculus.vrcast/0 com.oculus.ocms/0",
          "off": "sh /data/adb/modules/zygisk_vector/cli scope set org.codeberg.anonymous950.questenhancer com.oculus.systemux/0 com.oculus.vrshell/0 com.oculus.panelapp.settings/0 com.oculus.horizon/0 com.oculus.vrcast/0",
          "hint": "QuestEnhancer's OCMS hook. OCMS itself must stay enabled.",
          "confirmOff": "Meta's apps can update themselves again. That once broke Chats on this firmware. Allow app auto-updates?"
        }
      ]
    },
