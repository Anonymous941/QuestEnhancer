    {
      "id": "cast-shim",
      "name": "Cast fix for dual-network TVs",
      "area": "Casting",
      "summary": "Fix 07: a TV with Ethernet and Wi-Fi both up sends its feedback from its other address, and Horizon's old WebRTC drops it (slow, laggy casts). The shim lets that feedback through. Not yet proven to fix it.",
      "author": "Bubbagum88",
      "url": "https://github.com/Bubbagum88/QuestEnhancer/tree/main/fixes/07-cast-feedback-shim",
      "licence": "GPL-3.0",
      "risk": "safe",
      "check": "[ -d /data/adb/modules/quest1_cast_feedback_shim ] || exit 3; echo \"shim=$(getprop debug.qe.cast_shim)\"; echo \"log=$(getprop debug.qe.cast_shim_log)\"",
      "install": "Not installed: flash 07-cast-feedback-shim-rN.zip in Magisk, then restart.",
      "controls": [
        {
          "type": "switch",
          "label": "Shim on",
          "state": "^shim=1$",
          "on": "setprop debug.qe.cast_shim 1",
          "off": "setprop debug.qe.cast_shim 0",
          "hint": "Until the next restart. Start a new cast after changing it."
        },
        {
          "type": "switch",
          "label": "Log what it does",
          "state": "^log=1$",
          "on": "setprop debug.qe.cast_shim_log 1",
          "off": "setprop debug.qe.cast_shim_log 0"
        }
      ]
    },
    {
      "id": "adb-port",
      "name": "Wireless adb on port 5555",
      "area": "System fixes",
      "summary": "Fix 01: adb over Wi-Fi on a fixed port with no pairing, after every restart. Anyone on the same Wi-Fi can connect while it's on: use it on a trusted network.",
      "author": "Bubbagum88",
      "url": "https://github.com/Bubbagum88/QuestEnhancer/tree/main/fixes/01-adb-fixed-port",
      "licence": "GPL-3.0",
      "risk": "safe",
      "check": "echo \"port=$(getprop persist.adb.tcp.port)\"",
      "controls": [
        {
          "type": "switch",
          "label": "Fixed port 5555",
          "state": "^port=5555$",
          "on": "setprop persist.adb.tcp.port 5555",
          "off": "resetprop -p --delete persist.adb.tcp.port",
          "hint": "Takes effect at the next restart",
          "confirmOff": "After the next restart adb works over USB only, until you set this again. Turn it off?"
        }
      ]
    },
    {
      "id": "chats",
      "name": "Chats crash loop",
      "area": "System fixes",
      "summary": "Fix 02: Chats (com.oculus.socialplatform) needs a class this firmware doesn't have and crashes every few seconds. Disabling it stops that. Don't uninstall it: that makes Presence crash instead.",
      "author": "Bubbagum88",
      "url": "https://github.com/Bubbagum88/QuestEnhancer/tree/main/fixes/02-chats-crashloop",
      "licence": "GPL-3.0",
      "risk": "safe",
      "check": "if pm list packages -d | grep -qx package:com.oculus.socialplatform; then echo chats=disabled; else echo chats=enabled; fi",
      "controls": [
        {
          "type": "switch",
          "label": "Chats disabled",
          "state": "^chats=disabled$",
          "on": "pm disable-user --user 0 com.oculus.socialplatform",
          "off": "pm enable com.oculus.socialplatform",
          "confirmOff": "Chats will crash every few seconds again. Enable it?"
        }
      ]
    },
    {
      "id": "devsettings",
      "name": "Android Developer options",
      "area": "System fixes",
      "summary": "Fix 03: Android's Developer options page crashed on open (SELinux kept it from reading memory info). The module allows exactly those reads.",
      "author": "Bubbagum88",
      "url": "https://github.com/Bubbagum88/QuestEnhancer/tree/main/fixes/03-devsettings-selinux",
      "licence": "GPL-3.0",
      "risk": "reboot",
      "after": "reboot",
      "check": "m=/data/adb/modules/quest1_devsettings_fix; [ -d $m ] || exit 3; if [ -f $m/disable ]; then echo module=off; else echo module=on; fi",
      "install": "Not installed: flash 03-devsettings-selinux-rN.zip in Magisk, then restart.",
      "controls": [
        {
          "type": "switch",
          "label": "Fix on",
          "state": "^module=on$",
          "on": "rm -f /data/adb/modules/quest1_devsettings_fix/disable",
          "off": "touch /data/adb/modules/quest1_devsettings_fix/disable"
        },
        {
          "type": "button",
          "label": "Developer options",
          "on": "Open",
          "run": "am force-stop com.android.settings; am start -n 'com.android.settings/.Settings$DevelopmentSettingsDashboardActivity'"
        }
      ]
    },
    {
      "id": "boot-logo",
      "name": "Boot logo",
      "area": "System fixes",
      "summary": "Fix 05: your own logo, picked at random each boot, in the boot animation instead of the Meta logo. The first ~2 s Meta logo is in signed firmware and can't change.",
      "author": "Bubbagum88",
      "url": "https://github.com/Bubbagum88/QuestEnhancer/tree/main/fixes/05-boot-logo",
      "licence": "GPL-3.0",
      "risk": "reboot",
      "after": "reboot",
      "check": "m=/data/adb/modules/quest1_boot_logo; [ -d $m ] || exit 3; if [ -f $m/disable ]; then echo module=off; else echo module=on; fi; echo \"logos=$(ls /data/adb/modules/quest1_boot_logo/logos 2>/dev/null | grep -c '\\.png$')\"",
      "install": "Not installed: put your logos in fixes/05-boot-logo/module/logos and flash the zip in Magisk.",
      "controls": [
        {
          "type": "switch",
          "label": "Custom boot logo",
          "state": "^module=on$",
          "on": "rm -f /data/adb/modules/quest1_boot_logo/disable",
          "off": "touch /data/adb/modules/quest1_boot_logo/disable"
        },
        {
          "type": "button",
          "label": "Pick another logo for the next boot",
          "on": "Pick",
          "run": "sh /data/adb/modules/quest1_boot_logo/pick.sh"
        }
      ]
    },
    {
      "id": "ui-sounds",
      "name": "Charging sound",
      "area": "System fixes",
      "summary": "Fix 11: plays your own sound when you plug the headset in (or replaces any other UI sound with qesound). Put a real .ogg file at /sdcard/QuestEnhancer/sounds/charging.ogg. Changes play after a restart.",
      "author": "Bubbagum88, after a Monterey Club Discord tip",
      "url": "https://github.com/Bubbagum88/QuestEnhancer/tree/main/fixes/11-charging-sound",
      "licence": "GPL-3.0",
      "risk": "reboot",
      "after": "reboot",
      "check": "qesound status",
      "install": "Not installed: flash 11-charging-sound-rN.zip in Magisk, then restart.",
      "controls": [
        {
          "type": "button",
          "label": "Use /sdcard/QuestEnhancer/sounds/charging.ogg",
          "on": "Use",
          "run": "qesound set ChargingStarted /sdcard/QuestEnhancer/sounds/charging.ogg"
        },
        {
          "type": "button",
          "label": "Back to Meta's sound",
          "on": "Reset",
          "run": "qesound reset ChargingStarted"
        }
      ]
    },
    {
      "id": "backlight",
      "name": "Display brightness",
      "area": "Display",
      "summary": "Fix 12: holds the display backlight at a value you choose while the display is on (never while it's off). A brighter panel runs warmer and an OLED ages faster; the system's own value is the safe choice.",
      "author": "Bubbagum88, after a Monterey Club Discord tip",
      "url": "https://github.com/Bubbagum88/QuestEnhancer/tree/main/fixes/12-backlight",
      "licence": "GPL-3.0",
      "risk": "safe",
      "check": "if [ -d /data/adb/modules/quest1_backlight ]; then qebacklight status; else echo \"now=$(cat /sys/class/leds/lcd-backlight/brightness)\"; echo \"max=$(cat /sys/class/leds/lcd-backlight/max_brightness)\"; echo pin=missing; fi",
      "controls": [
        {
          "type": "switch",
          "label": "Hold brightness",
          "hint": "Needs fix 12 (12-backlight-rN.zip). Applies within 2 s.",
          "state": "^pin=1$",
          "on": "qebacklight pin on",
          "off": "qebacklight pin off"
        },
        {
          "type": "choice",
          "label": "Value",
          "state": "^value=(\\d+)$",
          "run": "qebacklight value {value}",
          "options": [
            {
              "label": "Low",
              "value": "60"
            },
            {
              "label": "Half",
              "value": "127"
            },
            {
              "label": "High",
              "value": "200"
            },
            {
              "label": "Max",
              "value": "255"
            }
          ]
        }
      ]
    },
    {
      "id": "qe-hooks",
      "name": "QuestEnhancer hooks",
      "area": "QuestEnhancer",
      "summary": "This app's Xposed hooks: hidden settings, dock pins, casting fixes.",
      "author": "Anonymous941 + Bubbagum88",
      "url": "https://github.com/Bubbagum88/QuestEnhancer",
      "licence": "GPL-3.0",
      "risk": "safe",
      "check": "sh /data/adb/modules/zygisk_vector/cli scope ls org.codeberg.anonymous950.questenhancer",
      "onIf": "com\\.oculus\\.systemux"
    }
  ]
}
